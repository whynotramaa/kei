# Template for /opt/cueline/.env.prod on the server, which is host-owned and
# chmod 600. first-deploy.sh writes it the first time. Edit it there, then:
#   cd /opt/cueline && docker compose -p cueline \
#     -f docker/docker-compose.prod.yml --env-file .env.prod up -d

PORT=8080
# 0.0.0.0 inside the container. The loopback restriction is the compose port
# mapping, not the bind address.
HOST=0.0.0.0

# STUN is enough on home and cafe networks.
STUN_URLS=stun:stun.l.google.com:19302

# TURN is what gets you through corporate NAT. Fill these in only when a call
# reaches connection state "failed". Prefer a provider that offers turns: on
# 443, because networks that block everything else usually leave 443 open.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
