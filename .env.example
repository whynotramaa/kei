# The deploy script writes /etc/cueline.env on the server from this template.
# Edit it there, then run: systemctl restart cueline

PORT=8080
# Bind to loopback behind nginx. Use 0.0.0.0 only for the LAN test path.
HOST=127.0.0.1

# STUN is enough on home and cafe networks.
STUN_URLS=stun:stun.l.google.com:19302

# TURN is what gets you through corporate NAT. Fill these in only when a call
# reaches connection state "failed". Prefer a provider that offers turns: on
# 443, because networks that block everything else usually leave 443 open.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
