[Unit]
Description=CueLine signalling
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/cueline/server
ExecStart=/usr/bin/node index.js
EnvironmentFile=/etc/cueline.env
Restart=always
RestartSec=3
User=cueline
Group=cueline

# The process relays JSON. It has no business reading the rest of the disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cueline/server

[Install]
WantedBy=multi-user.target
